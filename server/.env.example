# Sao chép file này thành ".env" (cùng thư mục) rồi điền thông tin thật.

# Chuỗi kết nối MongoDB (Atlas hoặc local). Lấy ở MongoDB Atlas > Connect > Drivers.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/nhakhoa?appName=Cluster0

# Khóa bí mật ký JWT - hãy đổi thành chuỗi ngẫu nhiên của riêng bạn.
JWT_SECRET=doi_thanh_chuoi_bi_mat_ngau_nhien

# Cổng chạy server (mặc định 3001).
PORT=3001
